<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vl53l5cx_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 driver for the ST VL53L5CX 8x8 multizone ToF sensor over I2C, plus 2D matrix viewers.</description>
  <maintainer email="edward@todo.todo">edward</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- pip deps: vl53l5cx-ctypes and smbus2 (pip install with the user flag) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
